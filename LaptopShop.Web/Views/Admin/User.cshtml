@model List<LaptopShop.Web.Models.DTOs.UserDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Users";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Manage Users</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Admin">DashBoard</a></li>
        <li class="breadcrumb-item active">Users</li>
    </ol>
    <div class="container mt-5">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="row">
            <div class="col-12 mx-auto">
                <div class="d-flex justify-content-between">
                    <h1>Table User</h1>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">Create user</button>
                </div>
                <hr />
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-table me-1"></i>
                        Danh sách tài khoản
                    </div>
                    <div class="card-body">
                        <table class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Email</th>
                                    <th>Full Name</th>
                                    <th>Role</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model)
                                {
                                    <tr>
                                        <td>@u.Id</td>
                                        <td>@u.Email</td>
                                        <td>@u.FullName</td>
                                        <td>@u.RoleName</td>
                                        <td>
                                            <a href="/Admin/User/View/@u.Id" class="btn btn-success">View</a>
                                            <button type="button" class="btn btn-warning mx-2" data-bs-toggle="modal" data-bs-target="#updateModal-@u.Id">Update</button>
                                            <a href="/Admin/User/Delete/@u.Id" class="btn btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa người dùng này?');">Delete</a>
                                            
                                            <!-- Update Modal for User @u.Id -->
                                            <div class="modal fade text-start" id="updateModal-@u.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-lg">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Update User - @u.Email</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <form method="post" action="/Admin/User/Update/@u.Id" enctype="multipart/form-data">
                                                            <div class="modal-body">
                                                                <div class="row">
                                                                    <div class="mb-3 col-12 col-md-6">
                                                                        <label class="form-label">Email:</label>
                                                                        <input type="email" class="form-control" name="Email" value="@u.Email" required />
                                                                    </div>
                                                                    <div class="mb-3 col-12 col-md-6">
                                                                        <label class="form-label">Password (Để trống nếu không đổi):</label>
                                                                        <input type="password" class="form-control" name="Password" />
                                                                    </div>
                                                                    <div class="mb-3 col-12 col-md-6">
                                                                        <label class="form-label">Full Name:</label>
                                                                        <input type="text" class="form-control" name="FullName" value="@u.FullName" required />
                                                                    </div>
                                                                    <div class="mb-3 col-12 col-md-6">
                                                                        <label class="form-label">Address:</label>
                                                                        <input type="text" class="form-control" name="Address" value="@u.Address" required />
                                                                    </div>
                                                                    <div class="mb-3 col-12 col-md-6">
                                                                        <label class="form-label">Phone:</label>
                                                                        <input type="text" class="form-control" name="Phone" value="@u.Phone" required />
                                                                    </div>
                                                                    <div class="mb-3 col-12 col-md-6">
                                                                        <label class="form-label">Role:</label>
                                                                        <select class="form-select" name="RoleId">
                                                                            <option value="1" selected="@(u.RoleId == 1)">ADMIN</option>
                                                                            <option value="2" selected="@(u.RoleId == 2)">USER</option>
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                                <button type="submit" class="btn btn-warning">Update</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <nav aria-label="Page navigation example">
                            <ul class="pagination justify-content-center">
                                <li class="page-item">
                                    <a class="@(1 == ViewBag.CurrentPage ? "disabled page-link" : "page-link")"
                                       href="/Admin/User?page=@(ViewBag.CurrentPage - 1)" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                @for (int i = 0; i < ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item">
                                        <a class="@((i + 1) == ViewBag.CurrentPage ? "active page-link" : "page-link")"
                                           href="/Admin/User?page=@(i + 1)">
                                            @(i + 1)
                                        </a>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="@(ViewBag.TotalPages == ViewBag.CurrentPage ? "disabled page-link" : "page-link")"
                                       href="/Admin/User?page=@(ViewBag.CurrentPage + 1)" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/User/Create" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="row">
                        <div class="mb-3 col-12 col-md-6">
                            <label class="form-label">Email:</label>
                            <input type="email" class="form-control" name="Email" required />
                        </div>
                        <div class="mb-3 col-12 col-md-6">
                            <label class="form-label">Password:</label>
                            <input type="password" class="form-control" name="Password" required />
                        </div>
                        <div class="mb-3 col-12 col-md-6">
                            <label class="form-label">Full Name:</label>
                            <input type="text" class="form-control" name="FullName" required />
                        </div>
                        <div class="mb-3 col-12 col-md-6">
                            <label class="form-label">Address:</label>
                            <input type="text" class="form-control" name="Address" required />
                        </div>
                        <div class="mb-3 col-12 col-md-6">
                            <label class="form-label">Phone:</label>
                            <input type="text" class="form-control" name="Phone" required />
                        </div>
                        <div class="mb-3 col-12 col-md-6">
                            <label class="form-label">Role:</label>
                            <select class="form-select" name="RoleId">
                                <option value="2">USER</option>
                                <option value="1">ADMIN</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
